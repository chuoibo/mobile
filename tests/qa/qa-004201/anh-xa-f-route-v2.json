  "F46": {"ten": "Group Check-in", "du_lieu_routes": ["POST /contexts/{context_id}/checkins", "POST /outing-stops/{stop_id}/checkins", "GET /outings/{outing_id}/checkins"], "nang_luc_route": "POST /contexts/{context_id}/checkins"},
  "F47": {"ten": "Automatic Place Detection", "du_lieu_routes": ["GET /areas", "GET /places", "POST /contexts/{context_id}/checkins"], "nang_luc_route": null,
          "ghi_chu": "Du lieu = toa do GPS + danh sach dia diem + trang thai xac nhan. GET /areas tra that (id/label/lat/lng). Nang luc rieng = TU DONG doi chieu GPS voi dia diem roi hoi xac nhan: khong route nao nhan toa do de suy ra dia diem. Day la o P thu 4, tim ra bang chinh phep dem moi chu khong phai do Lead chi."}
