  "F36": {"ten": "Automatic Trip Album", "du_lieu_routes": ["GET /contexts/{context_id}/albums", "GET /contexts/{context_id}/albums/{outing_id}"], "nang_luc_route": "GET /contexts/{context_id}/albums/{outing_id}"},
  "F37": {"ten": "AI Highlight Reel", "du_lieu_routes": ["GET /contexts/{context_id}/albums/{outing_id}/reel", "GET /contexts/{context_id}/albums/{outing_id}"], "nang_luc_route": "GET /contexts/{context_id}/albums/{outing_id}/reel",
          "ghi_chu": "Route reel co that va danh rieng cho viec CHON khoanh khac. Phan 'video ky niem 30s' spec doi thi CHUA do duoc o day -- xem o chua quet."},
  "F38": {"ten": "Locket Style Widget", "du_lieu_routes": ["GET /contexts/{context_id}/widget"], "nang_luc_route": "GET /contexts/{context_id}/widget"},
  "F39": {"ten": "Post", "du_lieu_routes": ["POST /posts", "GET /posts", "GET /posts/{post_id}", "GET /people/{person_id}/posts"], "nang_luc_route": "POST /posts"},
  "F40": {"ten": "Reactions", "du_lieu_routes": ["POST /contexts/{context_id}/memories/{memory_id}/reactions", "DELETE /contexts/{context_id}/memories/{memory_id}/reactions"], "nang_luc_route": "POST /contexts/{context_id}/memories/{memory_id}/reactions"},
  "F41": {"ten": "Comments", "du_lieu_routes": ["POST /contexts/{context_id}/memories/{memory_id}/comments", "GET /contexts/{context_id}/memories/{memory_id}/comments"], "nang_luc_route": "POST /contexts/{context_id}/memories/{memory_id}/comments"},
  "F42": {"ten": "Privacy", "du_lieu_routes": ["POST /posts", "GET /posts", "GET /people/{person_id}/posts"], "nang_luc_route": "POST /posts",
          "ghi_chu": "SUA so voi ban 1. Ban 1 gan F42 -> PUT /contexts/{id}/members/{person_id}/role + DELETE .../members/{person_id}, tuc quyen THANH VIEN NHOM, chi vi tieu de la 'Privacy'. Spec dong ung voi F42 noi ve PHAM VI HIEN THI BAI DANG (Only me / Friends / Group / Public). Truong that la 'audience' trong PostCreateRequest va PostResponse (doc tu /openapi.json). Cung mot lop loi 'gan theo tu trong tieu de', lan nay khong doi con so nhung doi bang chung."},
  "F43": {"ten": "Social Map", "du_lieu_routes": ["GET /contexts/{context_id}/map"], "nang_luc_route": "GET /contexts/{context_id}/map"},
  "F44": {"ten": "Group Heatmap", "du_lieu_routes": ["GET /contexts/{context_id}/heatmap"], "nang_luc_route": "GET /contexts/{context_id}/heatmap"},
