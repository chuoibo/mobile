# Docker only reads .dockerignore from the *build context root*. The build
# context for this image is services/api/, so the repo-root .dockerignore never
# applied to it — tests/ and scratch files were being shipped into the context.
# This file is the one that actually takes effect.
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.venv

# Test suite: the runtime image must not contain it, and it has no business
# being transferred as context either.
tests

# Local scratch and secrets. .env must never reach an image layer.
.env
.env.*
.resume-*.md
tools
