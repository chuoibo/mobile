      "chuyen_toi_thieu": 1,
      "chuyen_cua_greedy": 1,
      "can_duoi": "b vao 50000 ra 50000 nen lech 0 va bi loai. Con 2 nguoi, K<=1, min = 2 - 1 = 1 (thay vi 2 nghia vu tho)."
    }
  },
  {
