      ],
      "receipts": []
    },
    "expect": {
      "balances": {"a": -500000, "b": -400000, "c": 200000, "d": 300000, "e": 400000},
      "nguoi_lech_khac_khong": 5,
      "nhom_zero_sum": [["b", "e"], ["a", "c", "d"]],
      "so_nhom_toi_da": 2,
      "chuyen_toi_thieu": 3,
      "chuyen_cua_greedy": 4,
      "can_duoi": "5 nguoi lech. Moi nhom zero-sum can >= 2 nguoi nen K <= 2, va K = 2 dat duoc bang {b,e} + {a,c,d}. min = 5 - 2 = 3. Greedy ra 4: no ep a->e 400000 truoc, giet mat cap b/e vua khop."
    }
  },
