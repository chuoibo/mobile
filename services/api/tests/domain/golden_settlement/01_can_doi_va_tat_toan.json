    "input": {
      "obligations": [
        {"sender_id": "b", "recipient_id": "a", "amount_vnd": 120000}
      ],
      "receipts": []
    },
    "expect": {
      "balances": {"a": 120000, "b": -120000},
      "nguoi_lech_khac_khong": 2,
      "nhom_zero_sum": [["a", "b"]],
      "so_nhom_toi_da": 1,
      "chuyen_toi_thieu": 1,
      "chuyen_cua_greedy": 1,
      "can_duoi": "2 nguoi lech, moi nhom zero-sum can it nhat 1 con no + 1 chu no nen K<=1. min = N - K = 2 - 1 = 1."
    }
  },
  {
