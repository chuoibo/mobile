      "so_nhom_toi_da": 2,
      "chuyen_toi_thieu": 2,
      "chuyen_cua_greedy": 2,
      "can_duoi": "4 nguoi lech, chia duoc thanh 2 nhom zero-sum roi nhau nen K = 2 (toi da vi moi nhom can >= 2 nguoi). min = 4 - 2 = 2."
    }
  },
  {
