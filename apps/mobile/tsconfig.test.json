{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": false,
    "outDir": "dist-test",
    "rootDir": "src",
    "target": "es2022"
  },
  "include": [
    "src/api.ts",
    "src/assignment.ts",
    "src/participants.ts",
    "src/receipt.ts",
    "src/extraction.ts",
    "src/camera/access.ts",
    "src/camera/bill-photo.ts",
    "src/ui/direction.ts",
    "src/ui/a11y.ts",
    // bug-185426. The copy shown when the server itself refuses. Compiled on
    // its own line because the rule it carries -- a 5xx body never becomes the
    // sentence, and never reaches the screen uncut -- is assertable without a
    // renderer, and the excerpt half is the one worth pinning directly.
    "src/ui/loi-may-chu.ts",
    "src/ui/qr.ts",
    "src/ui/vietqr.ts",
    "src/navigation/tabs.ts",
    "src/navigation/nhom-demo.ts",
    "src/screens/kham-pha/places.ts",
    // F12's search box. `tim-kiem.ts` is the request and the reading of the
    // reply; `CauAiHieu.tsx` is compiled too because the requirement rd-fe-15
    // carries is that the model's reading is *on screen*, and whether a value
    // reached the markup is not a fact a source read can establish. See
    // `tim-dia-diem.test.mjs` and `hieu-cau-web.test.mjs`.
    "src/screens/kham-pha/tim-kiem.ts",
    "src/screens/kham-pha/CauAiHieu.tsx",
    // The catalogue screen itself, for `ChuaCoDuLieu`. Its 5xx card is the
    // second copy of the same dead end `CauAiHieu.tsx` renders for search, and
    // bug-185426 was present in both -- so both are rendered and read, rather
    // than one being trusted to stand for the other.
    "src/screens/kham-pha/KhamPha.tsx",
    "src/screens/chat/uuid5.ts",
    "src/screens/chat/tin-nhan.ts",
    "src/screens/chat/ke-hoach.ts",
    // F17's vote counting. Compiled so `binh-chon.test.mjs` can run the fold
    // under bare node, with no renderer and no server.
    "src/screens/chat/binh-chon.ts",
    "src/screens/chat/ai.ts",
    "src/screens/chat/nhom.ts",
    "src/screens/chat/TinNhan.tsx",
    "src/screens/chat/BongBong.tsx",
    "src/screens/chat/TheKeHoach.tsx",
    "src/screens/chat/ChiTietKeHoach.tsx",
    "src/screens/chat/ONhap.tsx",
    "src/navigation/lien-ket.ts",
    "src/screens/ca-nhan/tai-chinh.ts",
    // F30's date arithmetic. Compiled because the rule under test -- a trip's
    // calendar days must not be shifted by the reading machine's timezone -- is
    // invisible at +07 and at UTC, and only shows up when the test runs itself
    // in a negative offset. That is a property of this module, not of a screen.
    "src/screens/ky-niem/ky-uc.ts",
    // F01's number rules. The derivation itself moved to the server in
    // bug-140342 -- an unkeyed digest over 5x10^8 numbers is reversible -- so
    // what is compiled here is what the device still decides on its own: which
    // strings are a Vietnamese mobile number at all.
    "src/screens/vao-cua/danh-tinh.ts",
    // The entry door's requests, including the one that asks the server for an
    // id. Compiled so a test can assert the client refuses a bad number
    // BEFORE it travels, which is a property of this file and not of the API.
    "src/screens/vao-cua/cong-api.ts",
    // F05's friend code. Same reason as the line above, and one more: the
    // property that matters most here is a *negative* one -- no telephone
    // number reaches the payload -- and a negative is only worth asserting
    // against the string the encoder actually produces.
    "src/screens/vao-cua/ma-ban.ts",
    // Two screens compiled rather than only logic modules, so a test can
    // render them and read the markup react-native-web actually emits. See
    // `tools/fixup-esm.mjs` for why that is the real DOM and not a mock.
    "src/ui/Kit.tsx",
    "src/screens/GoiYChia.tsx",
    // The settlement screen and the code on it, for the same reason: the
    // masking rule and the amount cross-check are only observable in the
    // markup that actually reaches a browser.
    "src/ui/MaVietQr.tsx",
    "src/screens/KetQuaThanhToan.tsx",
    // The bank-destination form and the proposal screen that reports it back.
    // Same reason again, and it is the sharpest case of it: the rule under test
    // is "a full account number never reaches a screen the group reads", and
    // that is a fact about markup. Reading the source would only show that
    // `maskAccount` is called somewhere.
    "src/screens/tai-khoan/kiem-tra.ts",
    "src/screens/tai-khoan/TaiKhoanNhan.tsx",
    "src/screens/DeXuat.tsx",
    // The tab bar and the map strip, for the same reason once more: both carry
    // an ARIA role, and a role is only real once react-native-web has emitted
    // it. `aria-vai-tro.test.mjs` reads the markup these produce.
    "src/navigation/ThanhTab.tsx",
    "src/screens/kham-pha/DaiBanDo.tsx",
    // Cá nhân, for the keyboard tab-stop on its scroller. The screen holds
    // nothing pressable, so the stop is the only key that scrolls it, and
    // whether it survives is a fact about emitted markup rather than source:
    // `focusable` compiles just as well as `tabIndex` and reaches the DOM as
    // nothing. See `vung-cuon-ban-phim.test.mjs`.
    "src/screens/ca-nhan/CaNhan.tsx",
    // F13/F15 outing screens. Compiled so a test can run the pure rules under
    // bare node and render the two forms through react-native-web, the same
    // substitution Expo's web build performs, and read the markup a browser
    // would actually get. See `tools/fixup-esm.mjs`.
    "src/screens/len-plan/buoi-di.ts",
    "src/screens/len-plan/LenPlan.tsx",
    "src/screens/len-plan/TaoBuoiDi.tsx",
    "src/screens/len-plan/DongThoiGian.tsx"
  ]
}
