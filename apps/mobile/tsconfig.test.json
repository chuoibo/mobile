{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": false,
    "outDir": "dist-test",
    "rootDir": "src",
    "target": "es2022"
  },
  "include": [
    "src/api.ts",
    "src/assignment.ts",
    "src/participants.ts",
    "src/receipt.ts",
    "src/extraction.ts",
    "src/camera/access.ts",
    "src/camera/bill-photo.ts",
    // rd-fe-25. The pick-compress-upload-cleanup lifecycle for photographs the
    // group KEEPS, as opposed to a bill that is read and thrown away. Compiled
    // rather than read as source because the three claims that matter are all
    // negative -- a cancelled picker sends nothing, a failed upload leaves no
    // temp file behind, and no thrown value of any shape reaches the screen as
    // `[object ...]` -- and a negative is only settled by running the real
    // function over the values libraries really throw. See
    // `tests/tai-anh-len.test.mjs`.
    "src/camera/anh-nhom.ts",
    // The button those bytes leave through. Compiled so a test can render it
    // and read the markup react-native-web actually emits: the claim is that
    // an upload in flight is BOTH announced and unpressable, and `disabled`
    // and `aria-busy` are only real once they have reached the DOM.
    // `accessibilityState` compiles just as well and arrives as nothing --
    // that is the whole subject of `tests/aria-state.test.mjs`.
    "src/ui/NutChonAnh.tsx",
    "src/ui/direction.ts",
    "src/ui/a11y.ts",
    // Which image addresses the app will dial. Compiled on its own line because
    // the rule it carries is a *negative* one -- an address off our own API
    // never becomes a request -- and the bypasses worth pinning (`//host`,
    // a base that is a prefix of a longer host, userinfo before `@`) are
    // properties of this function, provable with no renderer and no server.
    "src/ui/nguon-anh.ts",
    // The frame that turns one of those addresses into a request. Compiled
    // rather than read as source because the claim it carries -- an allowed
    // address becomes a real `<img>`, a refused one becomes no element and no
    // preload -- is a fact about emitted markup. A source read cannot see it:
    // `<Image` stays spelled in the file whether or not the branch that mounts
    // it can ever be taken, which is exactly how the earlier gate here went
    // blind. See the render block in `tests/anh.test.mjs`.
    "src/ui/Anh.tsx",
    // bug-185426. The copy shown when the server itself refuses. Compiled on
    // its own line because the rule it carries -- a 5xx body never becomes the
    // sentence, and never reaches the screen uncut -- is assertable without a
    // renderer, and the excerpt half is the one worth pinning directly.
    "src/ui/loi-may-chu.ts",
    // bug-010822. The copy shown when the failure came from the device rather
    // than the server. Compiled on its own line because the rule it carries is
    // a negative one -- no thrown value, of any shape, can reach the screen as
    // `[object ...]` -- and a negative is only provable by running the function
    // over the values libraries really throw. See `tests/anh-hong.test.mjs`.
    "src/ui/loi-tren-man.ts",
    "src/ui/qr.ts",
    "src/ui/vietqr.ts",
    "src/navigation/tabs.ts",
    "src/navigation/nhom-demo.ts",
    "src/screens/kham-pha/places.ts",
    // F12's search box. `tim-kiem.ts` is the request and the reading of the
    // reply; `CauAiHieu.tsx` is compiled too because the requirement rd-fe-15
    // carries is that the model's reading is *on screen*, and whether a value
    // reached the markup is not a fact a source read can establish. See
    // `tim-dia-diem.test.mjs` and `hieu-cau-web.test.mjs`.
    "src/screens/kham-pha/tim-kiem.ts",
    "src/screens/kham-pha/CauAiHieu.tsx",
    // The catalogue screen itself, for `ChuaCoDuLieu`. Its 5xx card is the
    // second copy of the same dead end `CauAiHieu.tsx` renders for search, and
    // bug-185426 was present in both -- so both are rendered and read, rather
    // than one being trusted to stand for the other.
    "src/screens/kham-pha/KhamPha.tsx",
    // `GET /places/{id}`, the detail screen's own read. Compiled because the
    // rules worth pinning are all about a body this app does not control: a
    // review outside 0-5 is refused rather than clamped, an absent
    // `description` is null rather than "", and a 404 from a server that lacks
    // the route is a different sentence from a 404 for a place that is gone.
    // None of that is checkable by reading the screen. See
    // `tests/nam-man-chi-tiet.test.mjs`.
    "src/screens/kham-pha/chi-tiet-dia-diem.ts",
    "src/screens/chat/uuid5.ts",
    "src/screens/chat/tin-nhan.ts",
    "src/screens/chat/ke-hoach.ts",
    // F17's vote counting. Compiled so `binh-chon.test.mjs` can run the fold
    // under bare node, with no renderer and no server.
    "src/screens/chat/binh-chon.ts",
    // F17 again, the other transport. The line above folds ballots out of chat
    // messages; this one copies a tally the server already computed. Compiled
    // for the same reason and one sharper one: every rule in it is a REFUSAL of
    // a fallback -- no winner unless `decided_option_id` names one, no tie
    // inferred from a list length, no division when nobody has voted. A source
    // read cannot tell a refusal that holds from one that was written down, and
    // the failure it guards is the app casting the deciding vote. See
    // `tests/ket-qua-binh-chon.test.mjs`.
    "src/screens/binh-chon/ket-qua.ts",
    "src/screens/chat/ai.ts",
    "src/screens/chat/nhom.ts",
    "src/screens/chat/nhap-tu-chat.ts",
    "src/screens/chat/TheNhapChiTuChat.tsx",
    // F31/F33/F34/F36. Compile both the four-route client and the markup the
    // group-understanding test reads through react-native-web.
    "src/screens/ai-hieu-nhom/ai-hieu-nhom.ts",
    "src/screens/ai-hieu-nhom/AiHieuNhom.tsx",
    "src/screens/chat/TinNhan.tsx",
    "src/screens/chat/BongBong.tsx",
    "src/screens/chat/TheKeHoach.tsx",
    "src/screens/chat/ChiTietKeHoach.tsx",
    "src/screens/chat/ONhap.tsx",
    "src/navigation/lien-ket.ts",
    "src/screens/ca-nhan/tai-chinh.ts",
    // F39/F42. The wall on Cá nhân: audience copy, refusal sentences, and the
    // screen itself so a test can read the markup react-native-web emits for
    // the four radios and the disabled Đăng button.
    "src/screens/ca-nhan/bai-dang.ts",
    "src/screens/ca-nhan/Tuong.tsx",
    // F30's date arithmetic. Compiled because the rule under test -- a trip's
    // calendar days must not be shifted by the reading machine's timezone -- is
    // invisible at +07 and at UTC, and only shows up when the test runs itself
    // in a negative offset. That is a property of this module, not of a screen.
    "src/screens/ky-niem/ky-uc.ts",
    // F36/F37's album. Compiled rather than read as source because the rule
    // under test is a negative one about markup -- a place the server could not
    // name never reaches the reader as its `place_id` -- and `place_name ??
    // place_id` reads as perfectly reasonable in the source. It is only once
    // the card is rendered with a null that the UUID shows up where a place
    // name belongs. `album-api.ts` comes along for `TEN_DIA_DIEM_CHUA_BIET`,
    // so the test asserts the same constant the screen uses instead of
    // retyping the sentence. See `tests/ten-dia-diem-album.test.mjs`.
    "src/screens/album/album-api.ts",
    "src/screens/album/AlbumChuyenDi.tsx",
    // F38's moment line and refusal words. Compiled rather than read as source
    // because the rules under test are boundary rules -- 59 seconds versus 61,
    // six days versus seven -- and a source read cannot stand on either side of
    // a boundary. The timezone case is the same shape as `ky-uc.ts` one line
    // above: invisible at +07 and at UTC, visible only in a negative offset.
    "src/screens/widget/cau-chu.ts",
    // The screen itself, for the two states a screenshot run never reaches.
    // `quet-tab-url.mjs` drives the LOADED widget against a stub that always
    // has a photograph, so "the group has none yet" and "the server refused"
    // are rendered by nothing -- and the empty one is the state most likely to
    // be wrong, because it is a 200 the client could mistake for a failure.
    // Rendering it here reads the markup react-native-web really emits.
    "src/screens/widget/Widget.tsx",
    // F01's number rules. The derivation itself moved to the server in
    // bug-140342 -- an unkeyed digest over 5x10^8 numbers is reversible -- so
    // what is compiled here is what the device still decides on its own: which
    // strings are a Vietnamese mobile number at all.
    "src/screens/vao-cua/danh-tinh.ts",
    // The entry door's requests, including the one that asks the server for an
    // id. Compiled so a test can assert the client refuses a bad number
    // BEFORE it travels, which is a property of this file and not of the API.
    "src/screens/vao-cua/cong-api.ts",
    // F01.03's answers. Compiled because the rules that matter are arithmetic
    // and negative -- the budget bands are integer đồng that tile without a gap
    // or an overlap, a skipped band stays `null` instead of being back-filled,
    // and the default address-book seam resolves to "chưa có" rather than to a
    // granted it cannot honour. None of those is visible in a screenshot.
    "src/screens/vao-cua/so-thich.ts",
    // The screen itself, for the same reason `ThanhTab.tsx` two blocks down is
    // compiled: every control on it carries an ARIA role, and a role is only
    // real once react-native-web has emitted it. The tastes are `checkbox` in a
    // `group` and the budget bands are `radio` in a `radiogroup` -- picking the
    // wrong one of those pairs compiles fine and tells a screen reader the
    // opposite of what the screen does. See `tests/so-thich-web.test.mjs`.
    "src/screens/vao-cua/CaNhanHoa.tsx",
    // F05's friend code. Same reason as the line above, and one more: the
    // property that matters most here is a *negative* one -- no telephone
    // number reaches the payload -- and a negative is only worth asserting
    // against the string the encoder actually produces.
    "src/screens/vao-cua/ma-ban.ts",
    // Two screens compiled rather than only logic modules, so a test can
    // render them and read the markup react-native-web actually emits. See
    // `tools/fixup-esm.mjs` for why that is the real DOM and not a mock.
    "src/ui/Kit.tsx",
    "src/screens/GoiYChia.tsx",
    // The settlement screen and the code on it, for the same reason: the
    // masking rule and the amount cross-check are only observable in the
    // markup that actually reaches a browser.
    "src/ui/MaVietQr.tsx",
    "src/screens/KetQuaThanhToan.tsx",
    // The bank-destination form and the proposal screen that reports it back.
    // Same reason again, and it is the sharpest case of it: the rule under test
    // is "a full account number never reaches a screen the group reads", and
    // that is a fact about markup. Reading the source would only show that
    // `maskAccount` is called somewhere.
    "src/screens/tai-khoan/kiem-tra.ts",
    "src/screens/tai-khoan/TaiKhoanNhan.tsx",
    "src/screens/DeXuat.tsx",
    // The tab bar and the map strip, for the same reason once more: both carry
    // an ARIA role, and a role is only real once react-native-web has emitted
    // it. `aria-vai-tro.test.mjs` reads the markup these produce.
    "src/navigation/ThanhTab.tsx",
    "src/screens/kham-pha/DaiBanDo.tsx",
    // Cá nhân, for the keyboard tab-stop on its scroller. The screen holds
    // nothing pressable, so the stop is the only key that scrolls it, and
    // whether it survives is a fact about emitted markup rather than source:
    // `focusable` compiles just as well as `tabIndex` and reaches the DOM as
    // nothing. See `vung-cuon-ban-phim.test.mjs`.
    "src/screens/ca-nhan/CaNhan.tsx",
    // F03/F04's client half. The shape check is compiled so a test can pin it
    // against the server's own regex, and the refusal tables so a test can pin
    // every key against a code the server can really raise -- the check
    // `PUBLISH_REFUSALS` did not have when it shipped naming two codes that
    // existed nowhere in `services/api/app`.
    "src/screens/ca-nhan/ban-be.ts",
    // F13/F15 outing screens. Compiled so a test can run the pure rules under
    // bare node and render the two forms through react-native-web, the same
    // substitution Expo's web build performs, and read the markup a browser
    // would actually get. See `tools/fixup-esm.mjs`.
    "src/screens/len-plan/buoi-di.ts",
    "src/screens/len-plan/LenPlan.tsx",
    "src/screens/len-plan/TaoBuoiDi.tsx",
    "src/screens/len-plan/DongThoiGian.tsx",
    "src/screens/len-plan/NhanLoiMoi.tsx",
    // F14's other half. `NhanLoiMoi.tsx` above redeems an invite; this decides
    // whether one may be OFFERED, and every rule in it is a claim about what
    // `create_outing_invite` will accept. Compiled rather than read as source
    // because the sharpest of those claims is a negative one -- thu hồi does
    // not free the person to be invited again, because the unique index does
    // not care about `revoked_at` -- and a source read cannot tell a rule that
    // holds from one that was merely written down. See
    // `tests/moi-vao-chuyen.test.mjs`.
    "src/screens/len-plan/moi-vao-chuyen.ts",
    "src/screens/len-plan/MoiVaoChuyen.tsx",
    // 07.03. Every figure on the achievements screen is derived here from one
    // finance response -- level, all eight badges, all three weekly challenges.
    // Compiled rather than read as source because the claim worth pinning is
    // that those numbers MOVE with the ledger: a screen full of constants would
    // read identically in the source and identically on a screenshot, which is
    // exactly how a mockup gets typed in and shipped as a feature. The clock is
    // a parameter, so the seven-day window can be proved to be a window rather
    // than a lifetime count. See `tests/thanh-tich.test.mjs`.
    "src/screens/thanh-tich/thanh-tich.ts",
    "src/screens/quet-anh.ts",
    // The frozen bill behind the `?man=` scan pages. Compiled because the
    // claim it carries is arithmetic, not markup: the eight lines and the
    // who-ate-what matrix must fold to the same four allocations the
    // settlement fixture settles. A source read cannot check that, and if it
    // ever stops being true the scan pages still render -- `GoiYChia` just
    // prints "..." in every cell, and a detector would measure a screen caught
    // mid-flight while the report calls it the settled one. See
    // `tests/fixture-hai-man-giua.test.mjs`.
    "src/fixtures/thanh-toan-demo.ts",
    // The cold-start URL decision. Compiled rather than read as source because
    // the rule it carries is a negative one -- a URL that already names a route
    // produces no navigation -- and the version that lived inside a `useEffect`
    // could only be measured by driving an emulator.
    "src/rudi/duong-vao.ts",
    "src/rudi/otp-dang-cho.ts",
    "src/rudi/chat/tin-song.ts",
    "src/rudi/cua-fixture.ts",
    // Đọc/ghi phiên. Compile chứ không đọc nguồn vì luật nó mang là luật PHỦ
    // ĐỊNH: không blob nào, dù hỏng thế nào, được phép làm màn tiền ném. Một
    // chỉ số người sai trong dữ liệu đã lưu là crash ở MỌI lần mở app, và chỉ
    // có chạy hàm thật trên đúng những giá trị hỏng đó mới trả lời được.
    "src/rudi/luu-tru.ts",
    // Màn này đọc số của ai. Compile vì luật nó mang là: chế độ live KHÔNG BAO
    // GIỜ tự tới — phải có người gõ cấu hình vào. Một cổng đọc nguồn không phân
    // biệt được "không thăm dò máy chủ" với "chưa kịp viết đoạn thăm dò".
    "src/rudi/nguon.ts",
    // Đường tiền của màn Quyết toán ở chế độ live. Compile chứ không đọc
    // nguồn vì luật nó mang chỉ đo được trên một máy chủ THẬT ở chế độ prod:
    // request phải tự mang bearer. Đọc nguồn thấy `headerNguoiGoi(...)` là
    // xong, nhưng đó là đo cách viết; cái hỏng là 401 trên host thật, và chỉ
    // `tests/e2e/vertical-slice.test.mjs` gọi được nó qua HTTP để biết.
    "src/rudi/doc-live.ts",
    "src/rudi/money.ts",
    "src/rudi/places.ts",
    // Khám phá trên danh mục thật (M4): compile để test chứng minh danh mục được
    // đọc như người lạ KHÔNG mang context_id bịa và việc lưu đi với bearer.
    "src/rudi/kham-pha/dia-diem.ts",
    // Kèo trên máy chủ (M4): compile để test chứng minh PUT timeline mang place_id
    // và thêm/gắn chặng không đụng chặng khác.
    "src/rudi/keo/keo.ts",
    // Chia hóa đơn trong vỏ RuDi (M5): compile để test chứng minh khoản chi được
    // đề xuất bằng items của bill rồi chốt với expected_allocations của máy chủ,
    // mỗi lời gọi một Attempt, và không phép chia nào ở phía client.
    "src/rudi/chia-bill/hoa-don.ts",
    "src/rudi/dot-thu/dot-thu.ts",
    "src/rudi/vote.ts"
  ]
}
