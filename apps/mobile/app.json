{
  "expo": {
    "name": "RuDi",
    "slug": "rudi-mobile",
    "scheme": "rudi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lakiet.rudi",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Dùng camera để chụp ảnh bill, app đọc từng món rồi chia tiền. Ảnh chỉ gửi tới máy chủ của nhóm và bị xoá ngay sau khi đọc xong.",
        "NSPhotoLibraryUsageDescription": "Chọn một ảnh bill có sẵn khi bạn đã chụp từ trước. App chỉ đọc đúng ảnh bạn chọn."
      }
    },
    "android": {
      "package": "com.lakiet.rudi",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Dùng camera để chụp ảnh bill, app đọc từng món rồi chia tiền. Ảnh chỉ gửi tới máy chủ của nhóm và bị xoá ngay sau khi đọc xong.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chọn một ảnh bill có sẵn khi bạn đã chụp từ trước. App chỉ đọc đúng ảnh bạn chọn."
        }
      ],
      ["expo-dev-client", { "launchMode": "most-recent" }],
      "@react-native-google-signin/google-signin",
      "./plugins/tat-nut-noi-dev-menu"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
