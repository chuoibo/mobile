{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "puppeteer-core": "24.43.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:check && tsc -p tsconfig.test.json && node tools/fixup-esm.mjs && node --test $(find tests -path tests/e2e -prune -o -name '*.test.mjs' -print | sort)",
    "test:e2e": "tsc -p tsconfig.test.json && node tools/fixup-esm.mjs && node --test $(find tests/e2e -name '*.test.mjs' | sort)",
    "build:check": "EXPO_PUBLIC_API_URL=http://api.build-check.invalid expo export --platform web --output-dir .expo-build-check --clear"
  },
  "private": true
}
