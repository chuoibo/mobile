{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.17",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "puppeteer-core": "24.43.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:check && tsc -p tsconfig.test.json && node tools/fixup-esm.mjs && node --test $(find tests -path tests/e2e -prune -o -name '*.test.mjs' -print | sort)",
    "seed:rudi": "tsc -p tsconfig.test.json && node tools/fixup-esm.mjs && node tools/seed-rudi-world.mjs",
    "test:e2e": "tsc -p tsconfig.test.json && node tools/fixup-esm.mjs && node --test $(find tests/e2e -name '*.test.mjs' | sort)",
    "build:check": "EXPO_PUBLIC_API_URL=http://api.build-check.invalid expo export --platform web --output-dir .expo-build-check --clear"
  },
  "private": true
}
